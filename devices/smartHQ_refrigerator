        attribute "ambientTemperature", "number"
        attribute "ambientHumidity", "number"
    }
}

#include craigde.smarthqHelpers

// Force the SmartHQ app to re-authenticate and rebuild the shared cloud
// connection. The whole integration shares one WebSocket (owned by the
// connector child), so triggering this on any single appliance reconnects
// them all. Exposed as a command so it can be driven from a rule (e.g. a
// watchdog that fires after a period of no appliance activity).
def reconnect()
{
    parent?.initialize()
}

def refresh()
{
    refreshAppliance()
}

def parse(item)
{
    if(!item)
    {
        return
    }
    
    logDebug(item)
    
    def switchVal = item.erd?.toLowerCase()
    switch(switchVal)
    {
        case DOOR_STATUS:
            parseDoorStatus(item.value)
            break
        
        case CURRENT_TEMPERATURE:
        case TEMPERATURE_SETTING:
            parseTemps(item.value, switchVal)
            break
        
        case AIR_FILTER_STATUS:
        case WATER_FILTER_STATUS:
            parseFilterStatus(item.value, switchVal)
            break

        case SABBATH_MODE:
            parseSabbathMode(item.value)
            break

        case DOOR_FRESH_FOOD_1:
        case DOOR_FRESH_FOOD_2:
        case DOOR_FRESH_FOOD_3:
        case DOOR_FREEZER_1:
        case DOOR_CONVERTIBLE_1:
            parseSingleDoor(item.value, switchVal)
            break

        case CUMULATIVE_ENERGY:
            parseEnergy(item.value)
            break

        case AMBIENT_TEMPERATURE:
        case AMBIENT_HUMIDITY:
            parseAmbient(item.value, switchVal)
            break
    }
}

// One byte per door: 00 closed, 01 open. `contact` is open while any door is.
def parseSingleDoor(value, erd)
{
    try
    {
        def attr = DOOR_ATTRIBUTES[erd]
        def bytes = hubitat.helper.HexUtils.hexStringToByteArray(value)
        if(!attr || bytes.size() < 1) { return }

        def doors = state.doors ?: [:]
        doors[attr] = (0 == bytes[0]) ? "closed" : "open"
        state.doors = doors

        sendEvent(name: attr, value: doors[attr])
        sendEvent(name: "contact", value: doors.values().contains("open") ? "open" : "closed")
    }
    catch (Exception e)
    {
        logDebug("parse error: ${e.message}")
    }
}

// u32 watt-hours since the fridge was made; reported in kWh like the plugs.
def parseEnergy(value)
{
    try
    {
        def wh = Long.parseLong(value, 16)
        sendEvent(name: "energy", value: (wh / 1000.0).setScale(3, BigDecimal.ROUND_HALF_UP), unit: "kWh")
    }
    catch (Exception e)
    {
        logDebug("parse error: ${e.message}")
    }
}

// u16, hundredths of a degree F / of a percent.
def parseAmbient(value, erd)
{
    try
    {
        def raw = Integer.parseInt(value, 16)
        def v = (raw / 100.0).setScale(1, BigDecimal.ROUND_HALF_UP)
        if(AMBIENT_TEMPERATURE == erd)
        {
            sendEvent(name: "ambientTemperature", value: v, unit: "F")
        }
        else
        {
            sendEvent(name: "ambientHumidity", value: v, unit: "%")
        }
    }
    catch (Exception e)
    {
        logDebug("parse error: ${e.message}")
    }
}

def parseDoorStatus(value)
{
    try
    {
        def bytes = hubitat.helper.HexUtils.hexStringToByteArray(value)
        def events = []
        if(4 == bytes.size())
        {
            events += [name: "leftDoor", value: doorNCStatus(bytes[0])]
            events += [name: "rightDoor", value: doorNCStatus(bytes[1])]
            events += [name: "freezer", value: doorNCStatus(bytes[2])]
            events += [name: "drawer", value: doorNCStatus(bytes[3])]
        }

        flushEvents(events)
    }
    catch (Exception e)
    {
        logDebug("parse error: ${e.message}")
    }
}

def parseTemps(value, option)
{
    try
    {
        def bytes = hubitat.helper.HexUtils.hexStringToByteArray(value)
        def events = []
        if(2 == bytes.size())
        {
            def fridgeAttr = (CURRENT_TEMPERATURE == option) ? "fridgeActual" : "fridgeSetpoint"
            def freezerAttr = (CURRENT_TEMPERATURE == option) ? "freezerActual" : "freezerSetpoint"
            def fridgeTemp = decodeErdSignedByte(bytes[0])
            def freezerTemp = decodeErdSignedByte(bytes[1])

            events += [name: fridgeAttr, value: fridgeTemp, unit: "F"]
            events += [name: freezerAttr, value: freezerTemp, unit: "F"]

            // Mirror the fridge actual reading into the standard `temperature`
            // attribute required by TemperatureMeasurement so dashboards and
            // automations can use it directly.
            if(CURRENT_TEMPERATURE == option)
            {
                events += [name: "temperature", value: fridgeTemp, unit: "F"]
            }
        }

        flushEvents(events)
    }
    catch (Exception e)
    {
        logDebug("parse error: ${e.message}")
    }
}

def parseFilterStatus(value, option)
{
    try
    {
        def bytes = hubitat.helper.HexUtils.hexStringToByteArray(value)
        if(bytes.size() < 2) { return }

        def filterName = (AIR_FILTER_STATUS == option) ? "airFilterStatus" : "waterFilterStatus"

        def status = ((0 == bytes[0]) ? bytes[1] : bytes[0]).toInteger()
        sendEvent(name: filterName, value: filterStatus[status] ?: "unknown")

        // Update the standard `filterStatus` attribute (FilterStatus capability)
        // by combining both filters: any non-OK state on either rolls up to
        // "replace"; otherwise "normal". Detailed per-filter state is still
        // available in airFilterStatus / waterFilterStatus.
        updateRolledUpFilterStatus()
    }
    catch (Exception e)
    {
        logDebug("parse error: ${e.message}")
    }
}

private updateRolledUpFilterStatus()
{
    def needsReplace = ["replace", "expired", "leak detected"]
    def air = device.currentValue("airFilterStatus")
    def water = device.currentValue("waterFilterStatus")
    def status = (needsReplace.contains(air) || needsReplace.contains(water)) ? "replace" : "normal"
    sendEvent(name: "filterStatus", value: status)
}

// Conservative ranges for residential US refrigerators / freezers (degrees F).
// The appliance enforces its own limits but bounds checking here prevents the
// command from sending obvious nonsense / wrapped byte values.
@groovy.transform.Field static final FRIDGE_MIN_F = 33
@groovy.transform.Field static final FRIDGE_MAX_F = 47
@groovy.transform.Field static final FREEZER_MIN_F = -6
@groovy.transform.Field static final FREEZER_MAX_F = 8

def adjustSetpoints(fridge, freezer)
{
    if(fridge == null || freezer == null)
    {
        log.warn "adjustSetpoints requires both fridge and freezer values"
        return
    }

    def f = fridge.toInteger()
    def fz = freezer.toInteger()

    if(f < FRIDGE_MIN_F || f > FRIDGE_MAX_F)
    {
        log.warn "fridge setpoint ${f} out of range (${FRIDGE_MIN_F}..${FRIDGE_MAX_F})"
        return
    }
    if(fz < FREEZER_MIN_F || fz > FREEZER_MAX_F)
    {
        log.warn "freezer setpoint ${fz} out of range (${FREEZER_MIN_F}..${FREEZER_MAX_F})"
        return
    }

    def value = encodeErdSignedByte(f) + encodeErdSignedByte(fz)
    def erdMap = buildErdSetter(buildDevDetails(), buildErdDetails(TEMPERATURE_SETTING, value))

    parent?.sendWssMap(erdMap)
}

