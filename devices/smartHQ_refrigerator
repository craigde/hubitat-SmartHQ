    definition(name: "SmartHQ Refrigerator", namespace: "craigde", author: "craigde")
    {
        capability "Actuator"
        capability "FilterStatus"
        capability "Refresh"
        command "reconnect"
        attribute "healthStatus", "enum", ["offline", "online"]
        capability "TemperatureMeasurement"
        capability "ContactSensor"
