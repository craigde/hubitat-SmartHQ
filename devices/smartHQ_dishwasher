#include craigde.smarthqHelpers

// Force the SmartHQ app to re-authenticate and rebuild the shared cloud
// connection. The whole integration shares one WebSocket (owned by the
// connector child), so triggering this on any single appliance reconnects
// them all. Exposed as a command so it can be driven from a rule (e.g. a
// watchdog that fires after a period of no appliance activity).
def reconnect()
{
    parent?.initialize()
}

def refresh()
{
    refreshAppliance()
}

def parse(item)
{
    if(!item)
    {
        return
    }
    
    logDebug(item)
    
    switch(item.erd?.toLowerCase())
    {
        case DISHWASHER_DOOR_STATUS:
            parseDoorStatusByte(item.value, doorNormallyOpen)
            break
        
        case DISHWASHER_CYCLE_NAME:
            sendEvent(name: "cycleName", value: decodeErdString(item.value))
            break
        
        case DISHWASHER_CYCLE_STATE:
            parseCycleState(item.value)
            break
        
        case DISHWASHER_TIME_REMAINING:
            sendEvent(name: "timeRemaining", value: decodeErdInt(hubitat.helper.HexUtils.hexStringToByteArray(item.value)))
            break
        
        case DISHWASHER_OPERATING_MODE:
            parseMode(item.value)
            break
        
        case DISHWASHER_USER_SETTING:
            parseUserSetting(item.value)
            break
        
        case DISHWASHER_PODS_REMAINING_VALUE:
            sendEvent(name: "podsRemaining", value: decodeErdInt(hubitat.helper.HexUtils.hexStringToByteArray(item.value)))
            break
        
        case SABBATH_MODE:
            parseSabbathMode(item.value)
            break
        
        case USER_INTERFACE_LOCKED:
            parseControlLock(item.value)
            break

        case DISHWASHER_RINSE_AGENT:
            parseRinseAgent(item.value)
            break
    }
}

def parseCycleState(value)
{
    try
    {
        def bytes = hubitat.helper.HexUtils.hexStringToByteArray(value)
        def cState = knownStates[decodeErdInt(subBytes(bytes, 0, 1))]
        sendEvent(name: "cycleState", value: (null != cState) ? cState : "unknown")
        updateSwitchState()
    }
    catch (Exception e)
    {
        logDebug("parseCycleState error: ${e.message}")
    }
}

def parseMode(value)
{
    try
    {
        def bytes = hubitat.helper.HexUtils.hexStringToByteArray(value)
        def mode = knownModes[decodeErdInt(subBytes(bytes, 0, 1))]
        sendEvent(name: "mode", value: (null != mode) ? mode : "unknown")
        updateSwitchState()
    }
    catch (Exception e)
    {
        logDebug("parseMode error: ${e.message}")
    }
}

private updateSwitchState()
{
    // "Running" = the wash cycle is actively progressing through one of the
    // wet phases. We deliberately exclude pause, delay start, end, and idle
    // so "is the dishwasher running?" automations are accurate.
    def runningStates = ["prewash", "sensing", "main wash", "drying",
                         "sanitizing", "starting", "rinsing", "prewash1",
                         "final rinse", "end prewash1", "final rinse fill"]
    def cs = device.currentValue("cycleState")
    sendEvent(name: "switch", value: runningStates.contains(cs) ? "on" : "off")
}

// Switch on/off map to the existing start/stop commands so the dishwasher
// can be controlled from any rule or dashboard tile that targets a Switch.
def on()
{
    start()
}

def off()
{
    stop()
}

def parseUserSetting(value)
{
    try
    {
        def packed = decodeErdInt(hubitat.helper.HexUtils.hexStringToByteArray(value))

        def cycleMode = UserCycleSetting.getAt((packed & 0x0E) >> 1)
        def delay_hours = ((packed & 0xF0000) >> 16)
        def sound = SoundSetting.getAt((packed & 0x800000) >> 23)

        def events = []
        events += [name: "cycleMode", value: (null != cycleMode) ? cycleMode : "unknown"]
        events += [name: "delayHours", value: delay_hours]
        events += [name: "sound", value: (null != sound) ? sound : "unknown"]

        flushEvents(events)
    }
    catch (Exception e)
    {
        logDebug("parseUserSetting error: ${e.message}")
    }
}

// Rinse-aid level (ERD 0x3003). The byte-code -> level mapping is
// model-specific and was worked out empirically by the community (thanks to
// jmp / terminal3 on the Hubitat forum). Other dishwashers may report
// different codes, so unknown values fall through to "unknown" and the raw
// byte is logged at debug to make extending the map easy.
def parseRinseAgent(value)
{
    try
    {
        def raw = decodeErdInt(subBytes(hubitat.helper.HexUtils.hexStringToByteArray(value), 0, 1))
        def status = rinseAgentStates[raw]
        sendEvent(name: "rinseAgentStatus", value: (null != status) ? status : "unknown")
        logDebug("rinseAgentStatus: raw=${raw} -> ${status ?: 'unknown'}")
    }
    catch (Exception e)
    {
        logDebug("parseRinseAgent error: ${e.message}")
    }
}

def start()
{
    def ctrlMap = buildAppCtrlSetter(buildDevDetails(), buildCmdDetails("dishwasher-start"))
    
    parent?.sendWssMap(ctrlMap)
}

def stop()
{
    def ctrlMap = buildAppCtrlSetter(buildDevDetails(), buildCmdDetails("dishwasher-stop"))
    
    parent?.sendWssMap(ctrlMap)
}

// Set the detergent pod count.
//
// This writes pods-remaining ERD 0x301f directly. It used to POST the
// "dishwasher-set-pods" appliance#control command that gassgs reverse-engineered
// from the phone app in 2022; as of 2026 the cloud answers that command with
// "400 ... malformed syntax - Invalid JSON" for every operation, so it is gone.
// The ERD write is what Home Assistant's ge_home integration does (it exposes
// pods as a writable GeErdNumber on this ERD and never uses the control
// endpoint at all), and that integration works, so this follows it: a 2-byte
// big-endian value, matching gehomesdk's ErdIntConverter default length.
//
// One behavioural consequence: the ERD write is absolute, so "add" and
// "subtract" are now computed here from the current podsRemaining reading
// rather than by the cloud. If we have not seen that reading yet, there is
// nothing to add to, so those two operations ask for a Refresh first. "set"
// never needs it.
def adjustNumberOfPods(op, number)
{
    def operation = op?.toString()?.trim()?.toLowerCase()
    if(!(operation in ["add", "subtract", "set"]))
    {
        log.warn "adjustNumberOfPods: invalid operation '${op}' (expected add, subtract, or set)"
        return
    }

    def count
    try
    {
        count = (number instanceof Number) ? number.intValue() : "${number}".trim().toBigDecimal().intValue()
    }
    catch (Exception e)
    {
        log.warn "adjustNumberOfPods: '${number}' is not a valid number of pods"
        return
    }

    if(count < 0)
    {
        log.warn "adjustNumberOfPods: number of pods cannot be negative (${count})"
        return
    }

    def target = count

    if("set" != operation)
    {
        def current = device.currentValue("podsRemaining")
        if(null == current)
        {
            log.warn "adjustNumberOfPods: podsRemaining is not known yet, so '${operation}' has nothing to work from - hit Refresh (or use 'set') "
            return
        }

        target = ("add" == operation) ? (current.intValue() + count) : (current.intValue() - count)
    }

    // 0x301f carries a 2-byte value, so clamp to what the wire format holds
    // and to a count that means something.
    def clamped = Math.max(0, Math.min(target, 65535))
    if(clamped != target)
    {
        log.warn "adjustNumberOfPods: ${operation} ${count} would give ${target} pods; clamping to ${clamped}"
    }

    def erdMap = buildErdSetter(buildDevDetails(), buildErdDetails(DISHWASHER_PODS_REMAINING_VALUE, encodeErdInt(clamped, 2)))

    logDebug("adjustNumberOfPods: ${operation} ${count} -> writing ${clamped} to ${DISHWASHER_PODS_REMAINING_VALUE}")

    parent?.sendWssMap(erdMap)
}

