metadata
{
    definition(name: "SmartHQ Microwave", namespace: "craigde", author: "craigde")
    {
        capability "Actuator"
        capability "ContactSensor"
        capability "Refresh"
        command "reconnect"
        attribute "healthStatus", "enum", ["offline", "online"]
        capability "Switch"
        capability "FanControl"
        
        command "adjustCookSetting", [[name: "powerLevel*", type: "NUMBER"], [name: "minutes*", type: "NUMBER"], [name: "seconds*", type: "NUMBER"]]
        command "adjustMicrowaveState", [[name: "Cook status*", type:"ENUM", description:"Cook status mode to set", constraints: cookStatusNames()]]    
        
        attribute "cookMode", "enum" // cookModeNames() gives "Value too long for column" SQL error
        attribute "cookStatus", "enum", cookStatusNames()
        attribute "doorStatus", "enum", ["open", "closed"]
        attribute "powerLevel", "number"
        attribute "hoodLight", "enum", ["off", "dim", "high"]

        command "setHoodLight", [[name: "Light level*", type:"ENUM", constraints: ["off", "dim", "high"]]]
    }
}

#include craigde.smarthqHelpers

// Force the SmartHQ app to re-authenticate and rebuild the shared cloud
// connection. The whole integration shares one WebSocket (owned by the
// connector child), so triggering this on any single appliance reconnects
// them all. Exposed as a command so it can be driven from a rule (e.g. a
// watchdog that fires after a period of no appliance activity).
def reconnect()
{
    parent?.initialize()
}

def cookModeNames()
{
    return cookModes.collect { it.value.toString() }
}

def cookStatusNames()
{
    def statuses = cookStatuses.collect { it.value.toString() }
    
    // remove a couple that aren't usable for commands
    statuses.remove("completed")
    statuses.remove("unknown")
    
    return statuses
}

def refresh()
{
    refreshAppliance()
}

def parse(item)
{
    if(!item)
    {
        return
    }
    
    logDebug(item)
    
    def switchVal = item.erd?.toLowerCase()
    switch(switchVal)
    {
        case MICROWAVE_STATE:
            parseMicrowaveState(item.value)
            break

        case HOOD_FAN_SPEED:
            parseIntegerErd(item.value, 1, knownFanSpeeds, "speed")
            sendEvent(name: "supportedFanSpeeds", value: groovy.json.JsonOutput.toJson(knownFanSpeeds.collect { it.value }))
            break

        case HOOD_LIGHT_LEVEL:
            parseIntegerErd(item.value, 1, knownLightLevels, "hoodLight")
            break
    }
}

def parseMicrowaveState(value)
{
    try
    {
        def bytes = hubitat.helper.HexUtils.hexStringToByteArray(value)

        def status = cookStatuses[decodeErdInt(subBytes(bytes, 0, 1))] ?: "unknown"
        sendEvent(name: "cookStatus", value: status)
        sendEvent(name: "cookMode", value: cookModes[decodeErdInt(subBytes(bytes, 1, 1))] ?: "unknown")
        parseDoorStatusByte(value.substring(4,6), doorNormallyClosed)
        sendEvent(name: "powerLevel", value: decodeErdInt(subBytes(bytes, 3, 1)))

        // Roll cookStatus up into the standard `switch` attribute so
        // "notify me when microwave finishes" works natively.
        sendEvent(name: "switch", value: (status == "on") ? "on" : "off")
    }
    catch (Exception e)
    {
        logDebug("parse error: ${e.message}")
    }
}

// Switch is read-only; microwaves cannot be started remotely (safety).
// The `switch` attribute reflects current cookStatus.
def on()
{
    log.warn "${device.displayName}: switch is read-only; microwaves cannot be started remotely"
}

def off()
{
    log.warn "${device.displayName}: switch is read-only; use adjustMicrowaveState to stop a running cycle"
}

// Hood fan (FanControl). The `switch` attribute stays the cook status, so the
// fan is driven only through setSpeed / cycleSpeed. As in the Hood driver, the
// real value arrives when the appliance echoes HOOD_FAN_SPEED back to parse().
def setSpeed(fanspeed)
{
    setIntegerErd(fanspeed, knownFanSpeeds, HOOD_FAN_SPEED)
}

def cycleSpeed()
{
    def names = knownFanSpeeds.collect { it.value }
    def i = names.indexOf(device.currentValue("speed"))
    setSpeed(names[(i + 1) % names.size()])
}

def setHoodLight(level)
{
    setIntegerErd(level, knownLightLevels, HOOD_LIGHT_LEVEL)
}

def adjustMicrowaveState(state)
{
    def status = cookStatuses.find { it.value == state }?.key
    if(null == status)
    {
        log.warn "adjustMicrowaveState: unsupported status '${state}'"
        return
    }

    // The MICROWAVE_STATE ERD packs status, mode, door, and power level into
    // a single setter. We need the current values for the fields we're not
    // changing. Read whatever the last parse() call cached - blocking on a
    // refresh response is unreliable (the WebSocket is async) and earlier
    // versions used pauseExecution(500) which both blocked the hub thread
    // and gave no real guarantee the data would have arrived.
    def currentMode = device.currentValue("cookMode")
    def mode = cookModes.find { it.value == currentMode }?.key
    if(null == mode)
    {
        log.warn "adjustMicrowaveState: cookMode unknown (current='${currentMode}'); refresh and retry"
        refresh()
        return
    }

    def door = (device.currentValue("doorStatus") == "open") ? 1 : 0
    def plRaw = device.currentValue("powerLevel")
    if(null == plRaw)
    {
        log.warn "adjustMicrowaveState: powerLevel unknown; refresh and retry"
        refresh()
        return
    }
    def pl = plRaw.toInteger()
    def temp = "0000"

    def value =
        encodeErdInt(status, 1) +
        encodeErdInt(mode, 1) +
        encodeErdInt(door, 1) +
        encodeErdInt(pl, 1) +
        temp

    def erdMap = buildErdSetter(buildDevDetails(), buildErdDetails(MICROWAVE_STATE, value))

    parent?.sendWssMap(erdMap)
}

def adjustCookSetting(power, minutes, seconds)
{
    def value = encodeErdInt(power.toInteger(), 1) + encodeErdInt(minutes.toInteger(), 1) + encodeErdInt(seconds.toInteger(), 1)
    def erdMap = buildErdSetter(buildDevDetails(), buildErdDetails(MICROWAVE_COOK_SETTING, value))
    
    parent?.sendWssMap(erdMap)
}

