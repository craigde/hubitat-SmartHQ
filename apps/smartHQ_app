}

def uninstalled()
{
    unschedule()
    closeEventSocket()
    getChildDevices()?.each { deleteChildDevice(it.deviceNetworkId) }
}

def initialize()
{
    unschedule(initialize)
    closeEventSocket()

    def currentOp

    try
    {
        currentOp = "token"
        try
        {
            def refresh = get_oauth2_token("refresh")
            logDebug("refresh = ${refresh}")
        }
        catch(Exception e)
        {
            // refresh_token failed for some reason, so try a full re-auth
            def auth = get_oauth2_token("auth")
            logDebug("auth = ${auth}")
        }

        currentOp = "wss"
        def wssInfo = get_wss_credentials()
        logDebug("wssInfo = ${wssInfo}")

        if(!wssInfo?.endpoint)
        {
            log.warn "WSS credentials returned no endpoint"
            reinitialize()
            return
        }

        // Hand the endpoint to the connector child device. Hubitat does not
        // expose interfaces.webSocket to apps, so the WebSocket itself lives
        // in the SmartHQ Connector driver. Subscription + appliance list are
        // deferred to connectorOpened() so we don't send messages over a
        // socket that isn't connected yet.
        def connector = getOrCreateConnector()
        if(!connector)
        {
            log.warn "no connector child device available"
            reinitialize()
            return
        }
        connector.setEndpointAndConnect(wssInfo.endpoint)
    }
    catch(java.net.UnknownHostException e)
    {
        logDebug("${currentOp} failed (1): ${e}")
        reinitialize()
        return
    }
    catch(groovyx.net.http.HttpResponseException e)
    {
        logDebug("${currentOp} failed HTTP status: ${e.getResponse()?.getStatus()}")
        reinitialize()
        return
    }
    catch(Exception e)
    {
        logDebug("${currentOp} failed (2): ${e}")
        reinitialize()
        return
    }
}

//
// WebSocket connection management
// (delegated to the SmartHQ Connector child device because Hubitat does not
// allow apps to use interfaces.webSocket directly)
//

def connectorDni()
{
    return "SmartHQ-${app.id}-connector"
}

def getOrCreateConnector()
{
    def connector = getChildDevice(connectorDni())
    if(connector)
    {
        return connector
    }

    try
    {
        connector = addChildDevice("craigde", "SmartHQ Connector", connectorDni(),
            [label: "SmartHQ Connector", isComponent: true, name: connectorDni()])
        return connector
    }
    catch (com.hubitat.app.exception.UnknownDeviceTypeException e)
    {
        log.error "SmartHQ Connector driver is not installed. Install it via HPM or manually before saving the SmartHQ app."
        return null
    }
    catch (Exception e)
    {
        log.error "Failed to create connector child device: ${e}"
        return null
    }
}

def closeEventSocket()
{
    getChildDevice(connectorDni())?.closeConnection()
}

def sendWssMap(msg)
{
    if(!msg)
    {
        // a builder returned null (e.g. buildDevDetails before userId arrives).
        // Sending anyway would put the literal string "null" on the socket.
        logDebug("sendWssMap: nothing to send")
        return
    }

    def connector = getChildDevice(connectorDni())
    if(!connector)
    {
        logDebug("sendWssMap: no connector child")
        reinitialize()
        return
    }
    connector.sendWssMessage(msg)
}

//
// callbacks invoked by the SmartHQ Connector child device
//

def connectorOpened()
{
    state.reconnectDelay = 1

    try
    {
        subscribe_all()
        get_appliance_list()
    }
    catch (Exception e)
    {
        logDebug("post-open setup failed: ${e}")
        reinitialize()
    }
}

def connectorDisconnected(String reason)
{
    logDebug("connector disconnected: ${reason}")
    reinitialize()
}

def connectorParse(String message)
{
    logDebug("parse: ${message}")

    try
    {
        interpretResponse(new groovy.json.JsonSlurper().parseText(message))
    }
    catch (Exception e)
    {
        logDebug("parse error: ${e.message}")
    }
}

def reinitialize()
{
    unschedule(initialize)

    // exponential backoff: 2s, 4s, ... capped at 600s
    def delayCalc = (state.reconnectDelay ?: 1) * 2
    def reconnectDelay = (delayCalc <= 600) ? delayCalc : 600

    state.reconnectDelay = reconnectDelay
    runIn(reconnectDelay, initialize)
}

//
// integration functions
//

def createChildDevices(items)
{
    items.each
    {
        manageChildDevice(it.applianceId, it)
    }
}

def manageChildDevice(id, details = null)
{
    if(details == null)
    {
        // this is an event, which doesn't include the device type
        //   so, only a device that already exists will work
        return getChildDevice(childDni(id))
    }

    try
    {
        switch(details.type)
        {
            // alias types to more generic virtual device types
            case "Clothes Washer":
            case "Clothes Dryer":
                details.type = "Laundry"
                break
            case "Air Conditioner":
                details.type = "Portable AC"
                break
            case "Opal Nugget Ice Maker":
                details.type = "Ice Maker"
                break
        }

        def devDetails = [label: details.nickname ?: details.type, isComponent:false, name:childDni(id), devType: "SmartHQ " + details.type, mac: id]

        // use existing child, or create it
        def child = getChildDevice(childDni(id)) ?: addChildDevice("craigde", devDetails.devType, childDni(id), [label: devDetails.label, isComponent: false, name: devDetails.name])
        child?.setupDevDetails(devDetails)

        return child
    }
    catch(com.hubitat.app.exception.UnknownDeviceTypeException e)
    {
        log.info "Error: unsupported device type.  (id = ${id}, type = ${details.type})"
    }
    catch (Exception e)
    {
        logDebug("manageChildDevice error: ${e.message}")
    }
}

def childDni(id)
{
    return "SmartHQ-${app.id}-${id}"
}

// Method for child devices to get userId
def getUserIdForChild()
{
    return state.userId
}

//
// api operations
//

// The cloud answers every websocket#api request with a message that carries
// its own HTTP-style status code; a rejected request still arrives as an
// ordinary message, so nothing throws and the send looks like it worked. Any
// response we don't recognize used to be dropped with a bare debug line, which
// is why a refused command (setting the dishwasher pod count, for example)
// failed completely silently. Report the failure with the reason the cloud
// gave so it is actionable.
private isApiError(msgJson)
{
    def code = msgJson.body?.code ?: msgJson.code

    return ("error" == msgJson.body?.kind) || ((code instanceof Number) && (code >= 400))
}

private logApiError(msgJson)
{
    def code = msgJson.body?.code ?: msgJson.code
    def detail = [msgJson.body?.message, msgJson.body?.reason].findAll { it }.join(" - ")

    log.warn "SmartHQ request rejected (${msgJson.request?.method ?: 'request'} ${msgJson.request?.path ?: msgJson.id}): ${code}${detail ? ' ' + detail : ''}"
}

def interpretResponse(msgJson)
{
    if(!msgJson)
    {
        return
    }

    if(msgJson.kind == "websocket#api")
    {
        // this is an API response

        if(isApiError(msgJson))
        {
            logApiError(msgJson)
            return
        }

        switch(msgJson.id)
        {
            case "List-appliances":
                // we need this to set ERDs
                state.userId = msgJson.body?.userId

                // create child devices for known appliances
                logDebug msgJson.body?.items
                createChildDevices(msgJson.body?.items)
                break

            case ~/.*-allErd.*/:
                // this is a request_update response
                def id = msgJson.body?.applianceId

                msgJson.body?.items?.each
                {
                    manageChildDevice(id)?.parse(it)
                }

                break

            case ~/.*-setErd.*/:
                // successful response to setting an ERD.  nothing to do.
                break

            case ~/.*-control-.*/:
                // successful response to an appliance control command
                logDebug("control command accepted: ${msgJson.id}")
                break

            default:
                logDebug("Unsupported message: ${msgJson?.id}")
        }
    }

    if(msgJson?.item?.erd)
    {
        // this is an event

        manageChildDevice(msgJson.item.applianceId)?.parse(msgJson.item)
    }
}

def get_appliance_list()
{
    sendWssMap(buildWssMsg("GET", "/v1/appliance", "List-appliances"))
}

def request_update(mac)
{
    sendWssMap(buildWssMsg("GET", "/v1/appliance/${mac}/erd", mac + "-allErd"))
}

def subscribe_all()
{
    def msg =
        [
            kind: "websocket#subscribe",
            action: "subscribe",
            resources: ["/appliance/*/erd/*"]
        ]

    sendWssMap(msg)
}

//
// login flow
// (previously in smarthqHelpers; moved here because only the app uses it
// and the credentials don't belong in code that ships to every driver)
//

def genCookie1()
{
    return (null == loginRegion) ? cookie1 : cookie1.replace("us-east-1", loginRegion)
}

//
// HTML field extraction helper
// Replaces the old resp.data.'**' GPath deep-search, which depended on
// Hubitat auto-parsing the login/MFA page response into a GPathResult. On
// the latest firmware that auto-parse behavior changed (internal HTTP client
// is now com.hubitat.hub.executor.helpers.ExecutorHttpClient5), so '**'
// throws MissingPropertyException. Pulling the plain response text with
// textParser:true and regexing out the field avoids depending on that
// auto-parse behavior at all.
//
// Looks for <tag name="fieldName" ... attr="value" ...> or
// <tag ... attr="value" ... name="fieldName" ...> (attribute order can vary),
// trying each attr name in attrs in order (e.g. 'content' before 'value' for
// meta tags that may carry _csrf as content instead of value).
//
String extractAttr(String html, String fieldName, List attrs = ['value'])
{
    if(!html)
    {
        return null
    }

    for(attr in attrs)
    {
        def m = html =~ /(?s)<[^>]*\bname=["']${fieldName}["'][^>]*\b${attr}=["']([^"']*)["']/
        if(m.find())
        {
            return m.group(1)
        }

        m = html =~ /(?s)<[^>]*\b${attr}=["']([^"']*)["'][^>]*\bname=["']${fieldName}["']/
        if(m.find())
        {
            return m.group(1)
        }
    }

    return null
}

def get_authorization_code()
{
    def _csrf, signature
    def cookie2

    def params =
        [
            uri: loginUrl + "/oauth2/auth",
            query: [client_id: client_id, response_type: "code", access_type: "offline", redirect_uri: redirect_uri],
            headers: [cookie: genCookie1()],
            textParser: true
        ]

    def html
    httpGet(params)
    {
        resp ->

        // extract values (signature, _csrf) from HTML login page contents
        html = resp.data?.text ?: resp.data?.toString()

        // look for and capture the "JSESSION" header
        cookie2 = resp.headers.find { it.name == "Set-Cookie" && it.value.contains("JSESSION") }?.value
    }

    signature = extractAttr(html, 'signature')
    // _csrf may appear twice in the page (input value vs meta content), so
    // try content first, then value
    _csrf = extractAttr(html, '_csrf', ['content', 'value'])

    // both cookies must be sent together; a Groovy map literal silently
    // drops duplicate keys, so concatenate into a single Cookie header value
    def postParams =
        [
            body: [signature: signature, _csrf: _csrf, username: username, password: password],
            uri: loginUrl + "/oauth2/g_authenticate",
            followRedirects: false,
            headers: [cookie: "${genCookie1()}; ${cookie2}"]
        ]

    def paramsMap = [:]
    def respBody = ""
    def mfaSkipNeeded = false
    def mfaCookies = ""

    httpPost(postParams)
    {
        resp->

        def locVal = resp.headers['Location']?.value
        logDebug("g_authenticate Location: ${locVal}")

        if(locVal?.contains("mfamethod") || locVal?.contains("security/add"))
        {
            // GE is showing its non-persistent "test MFA" interstitial. Capture
            // the post-login session cookies so we can drive the "Skip" below.
            mfaSkipNeeded = true
            mfaCookies = resp.headers.findAll { it.name == "Set-Cookie" }
                                     .collect { it.value.split(";")[0].trim() }
                                     .join("; ")
        }
        else if(locVal && locVal.contains("?"))
        {
            parseRedirectParams(locVal, paramsMap)
        }
        else
        {
            // No redirect (or one without a query string) means the login POST
            // did not return an authorization code. Capture the body so we can
            // distinguish an MFA challenge from other failures below.
            respBody = resp.data?.toString() ?: ""
        }
    }

    if(mfaSkipNeeded)
    {
        // The MFA prompt offers a "Skip" option that isn't persistent, so we
        // replicate it on every login to continue to the real code redirect.
        skipMfaPrompt(mfaCookies, _csrf, paramsMap)
    }

    if(paramsMap.code)
    {
        state.remove("lastAuthError")
    }
    else
    {
        // No code means we cannot complete login. Surface a clear, actionable
        // reason instead of failing silently into the reconnect backoff.
        if(mfaSkipNeeded)
        {
            log.warn "SmartHQ login hit GE's MFA test prompt and the automatic Skip did not return an authorization code; the login flow may have changed."
            state.lastAuthError = "MFA skip failed"
        }
        else if(respBody =~ /(?i)multi-factor|multi factor|\bmfa\b|verification code/)
        {
            log.warn "SmartHQ login returned a Multi-Factor Authentication prompt instead of an authorization code; the integration cannot complete login automatically."
            state.lastAuthError = "MFA challenge encountered"
        }
        else
        {
            log.warn "SmartHQ login did not return an authorization code (check username, password, and region; the login flow may have changed)."
            state.lastAuthError = "Login failed (no authorization code)"
        }
    }

    return paramsMap.code
}

// Skip GE's non-persistent "test MFA" interstitial. Mirrors the website's
// "Skip" button: GET the MFA page for a fresh _csrf, merge any new session
// cookies on top of the post-login session, then POST an empty mfaType to the
// redirect endpoint so the OAuth flow continues to the real code redirect.
// MFA-skip flow contributed by youzer-name (GitHub PR #12).
private skipMfaPrompt(sessionCookies, fallbackCsrf, paramsMap)
{
    def mfaCsrf
    def cookies = sessionCookies

    def mfaGetParams =
        [
            uri: loginUrl + "/account/active/security/add/mfamethod",
            followRedirects: false,
            headers: [cookie: sessionCookies],
            textParser: true
        ]

    def html
    httpGet(mfaGetParams)
    {
        resp ->

        html = resp.data?.text ?: resp.data?.toString()

        // merge cookies the MFA page sets on top of the existing session,
        // keyed by name so we don't send duplicates
        def cookieMap = [:]
        sessionCookies.split("; ").each { kv -> def p = kv.split("=", 2); if(p.size() == 2) cookieMap[p[0]] = p[1] }
        resp.headers.findAll { it.name == "Set-Cookie" }
                    .collect { it.value.split(";")[0].trim() }
                    .each { kv -> def p = kv.split("=", 2); if(p.size() == 2) cookieMap[p[0]] = p[1] }
        cookies = cookieMap.collect { k, v -> "${k}=${v}" }.join("; ")
    }

    mfaCsrf = extractAttr(html, '_csrf', ['content', 'value'])

    def skipParams =
        [
            body: [mfaType: "", _csrf: mfaCsrf ?: fallbackCsrf],
            uri: loginUrl + "/account/active/redirect",
            followRedirects: false,
            headers: [cookie: cookies]
        ]

    httpPost(skipParams)
    {
        resp ->
        def locVal = resp.headers['Location']?.value
        logDebug("skipMfa Location: ${locVal}")
        parseRedirectParams(locVal, paramsMap)
    }
}

// Parse the query string of an OAuth redirect Location into paramsMap.
// Splits on the first '=' only and tolerates valueless params: String.split
// drops trailing empty fields, so an empty-valued param like "scope=" yields a
// length-1 array and indexing [1] there throws ArrayIndexOutOfBoundsException.
private parseRedirectParams(locVal, paramsMap)
{
    if(!(locVal && locVal.contains("?")))
    {
        return
    }

    def paramsList = locVal.substring(locVal.indexOf("?") + 1, locVal.length())
    paramsList?.split("&").each
    {
        def temp = it.split("=", 2)
        if(temp[0])
        {
            paramsMap.put(temp[0], (temp.size() > 1) ? temp[1] : "")
        }
    }
}

def get_oauth2_token(type)
{
    def postBody

    switch(type)
    {
        case "auth":
            postBody = [code: get_authorization_code(), client_id: client_id, client_secret: client_secret, redirect_uri: redirect_uri, grant_type: "authorization_code"]
            break

        case "refresh":
            postBody = [client_id: client_id, client_secret: client_secret, redirect_uri: redirect_uri, grant_type: "refresh_token", refresh_token: state.refresh_token]
            break
    }

    def postParams =
       [
           body: postBody,
           uri: loginUrl + "/oauth2/token",
           headers: [Authorization: "Basic " + ("${client_id}:${client_secret}").bytes.encodeBase64().toString()]
       ]

    def data
    httpPost(postParams)
    {
        resp->
        state.access_token = resp.data?.access_token
        state.refresh_token = resp.data?.refresh_token

        def expirSecs = resp.data?.expires_in?.toInteger()
        if(expirSecs)
        {
            // schedule re-auth 2 minutes before expiry; clamp to a sane minimum
            // so a short-lived token can't produce a negative or near-zero delay
            def reauthDelay = Math.max(expirSecs - 120, 60)
            runIn(reauthDelay, initialize)
        }

        data = resp.data
    }

    return data
}

def get_wss_credentials()
{
    def wssParams =
        [
            uri: apiUrl + "/v1/websocket",
            headers: [Authorization: "Bearer ${state.access_token}"]
        ]

    def data
    httpGet(wssParams)
    {
        resp->
        data = resp.data
    }

    return data
}
