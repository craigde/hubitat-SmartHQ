    {
        section("GE Account Credentials")
        {
            input name: "username", type: "text", title: "Username (email)", required: true
            input name: "password", type: "password", title: "Password", required: true
            input name: "loginRegion", type: "enum", title: "Authentication region (try different settings if login fails)", options: ["us-east-1", "us-west-2"], defaultValue: "us-east-1"
        }
        section("Logging")
        {
            input name: "logEnable", type: "bool", title: "Enable debug logging", defaultValue: true
        }
        if(state.lastAuthError)
        {
            section("Login Status")
            {
                paragraph "<b>Last login attempt failed:</b> ${state.lastAuthError}"
            }
        }
        if(state.access_token)
        {
            section("Discovered Appliances")
            {
                paragraph "Connected to SmartHQ. Appliances will be created automatically."
                def children = getChildDevices()
                if(children?.size() > 0)
                {
                    paragraph "Current devices: ${children.collect { it.label ?: it.name }.join(', ')}"
                }
            }
        }
    }
}

